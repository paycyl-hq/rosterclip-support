    document.getElementById('pdfButon').addEventListener('click', async function() {
        try {
            // 1. Base64 string'i fetch ile anında Blob'a (gerçek PDF dosyasına) çevir
            const response = await fetch(pdfDataUri);
            const blob = await response.blob();

            // 2. İşletim sistemi için sanal bir dosya URL'si oluştur
            const blobUrl = URL.createObjectURL(blob);

            // 3. Görünmez bir link yarat, tıkla ve sil
            const link = document.createElement('a');
            link.href = blobUrl;
            link.target = '_blank'; // iOS Safari için yeni sekmede native görüntüleme
            link.download = 'dokuman.pdf'; // Android için indirme tetiği
            
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            // 4. Hafızayı temizle
            setTimeout(() => URL.revokeObjectURL(blobUrl), 100);
            
        } catch (error) {
            alert("PDF yüklenirken bir hata oluştu.");
            console.error(error);
        }
    });
    </script>

